# ============================================================
# kessoku.theme — sanny
# ============================================================

# --- Main ---
theme[main_bg]="#000000"
theme[main_fg]="#F7AABC"
theme[title]="#F7AABC"
theme[hi_fg]="#c75255"
theme[selected_bg]="#1a1a1a"
theme[selected_fg]="#F7AABC"
theme[inactive_fg]="#2d2d2d"
theme[graph_text]="#E8D8CC"
theme[meter_bg]="#1a1a1a"
theme[proc_misc]="#e9d985"

# --- Box outlines — each member gets a box ---
theme[cpu_box]="#c75255"
theme[mem_box]="#516aa1"
theme[net_box]="#e9d985"
theme[proc_box]="#f59bb1"

# --- Divider ---
theme[div_line]="#2d2d2d"

# --- Temperature (cool -> warm -> hot) ---
theme[temp_start]="#516aa1"
theme[temp_mid]="#e9d985"
theme[temp_end]="#c75255"

# --- CPU graph (pink -> red) ---
theme[cpu_start]="#f59bb1"
theme[cpu_mid]="#c75255"
theme[cpu_end]="#F7AABC"

# --- Mem/Disk free (blue -> cyan) ---
theme[free_start]="#516aa1"
theme[free_mid]="#7EB8D4"
theme[free_end]="#90C8D8"

# --- Mem/Disk cached (blue shades) ---
theme[cached_start]="#516aa1"
theme[cached_mid]="#7EB8D4"
theme[cached_end]="#90C8D8"

# --- Mem/Disk available (yellow -> pink) ---
theme[available_start]="#e9d985"
theme[available_mid]="#F0C060"
theme[available_end]="#f59bb1"

# --- Mem/Disk used (pink -> red) ---
theme[used_start]="#f59bb1"
theme[used_mid]="#c75255"
theme[used_end]="#E94B67"

# --- Download (blue -> cyan) ---
theme[download_start]="#516aa1"
theme[download_mid]="#7EB8D4"
theme[download_end]="#90C8D8"

# --- Upload (yellow -> pink) ---
theme[upload_start]="#e9d985"
theme[upload_mid]="#F0C060"
theme[upload_end]="#f59bb1"

# --- Process gradient (pink -> red) ---
theme[process_start]="#f59bb1"
theme[process_mid]="#c75255"
theme[process_end]="#F7AABC"
