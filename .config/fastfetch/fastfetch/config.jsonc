{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/san/.config/fastfetch/bocchiimg.png",
    "width": 52,
    "height": 24,
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " ➜ ",
    "color": {
      "keys": "#F7AABC",
      "title": "#F7AABC"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "✦ {user-name}@{host-name} ✦"
    },
    "separator",
    { "type": "os",       "key": " 󰣇 sys   " },
    { "type": "kernel",   "key": " 󰌽 kern  " },
    { "type": "shell",    "key": "   shell " },
    { "type": "wm",       "key": " 󱂬 wm    " },
    { "type": "terminal", "key": "   term  " },
    { "type": "cpu",      "key": " 󰻠 cpu   " },
    { "type": "memory",   "key": " 󰍛 ram   " },
    { "type": "disk",     "key": " 󰋊 disk  " },
    { "type": "uptime",   "key": " 󰅐 up    " },
    "break",
    "colors"
  ]
}
