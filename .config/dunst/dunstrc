# --- Global ---
[global]
    font = JetBrainsMono Nerd Font 10
    frame_color = "#f59bb1"
    separator_color = "#f59bb1"
    corner_radius = 10
    origin = top-right
    offset = (10,10)
    padding = 8
    horizontal_padding = 10

# --- Urgency ---
[urgency_low]
    background = "#000000"
    foreground = "#516aa1"
    frame_color = "#516aa1"
    timeout = 5

[urgency_normal]
    background = "#000000"
    foreground = "#f59bb1"
    frame_color = "#f59bb1"
    timeout = 5

[urgency_critical]
    background = "#000000"
    foreground = "#c75255"
    frame_color = "#c75255"
    timeout = 0
