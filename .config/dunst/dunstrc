[global]
    font = JetBrainsMono Nerd Font 10
    frame_color = "#F7AABC"
    separator_color = "#F7AABC"
    corner_radius = 10
    origin = top-right
    offset = 10x10
    padding = 8
    horizontal_padding = 10

[base16_low]
    msg_urgency = low
    background = "#000000"
    foreground = "#F7AABC"
    frame_color = "#f28baa"

[base16_normal]
    msg_urgency = normal
    background = "#000000"
    foreground = "#F7AABC"
    frame_color = "#F7AABC"

[base16_critical]
    msg_urgency = critical
    background = "#000000"
    foreground = "#E94B67"
    frame_color = "#E94B67"
