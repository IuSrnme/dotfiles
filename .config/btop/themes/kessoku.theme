# Kessoku Band theme for btop
# Main
theme[main_bg]="#000000"
theme[main_fg]="#F7AABC"
theme[title]="#F7AABC"
theme[hi_fg]="#E94B67"
theme[selected_bg]="#1a1a1a"
theme[selected_fg]="#F7AABC"
theme[inactive_fg]="#2d2d2d"
theme[graph_text]="#E8D8CC"
theme[meter_bg]="#1a1a1a"
theme[proc_misc]="#F0C060"

# Box outlines — each member gets a box
theme[cpu_box]="#E94B67"
theme[mem_box]="#7EB8D4"
theme[net_box]="#F0C060"
theme[proc_box]="#E87FA0"

# Divider
theme[div_line]="#2d2d2d"

# Temperature (cool -> warm -> hot)
theme[temp_start]="#7EB8D4"
theme[temp_mid]="#F0C060"
theme[temp_end]="#E94B67"

# CPU graph (pink -> red)
theme[cpu_start]="#E87FA0"
theme[cpu_mid]="#E94B67"
theme[cpu_end]="#F7AABC"

# Mem/Disk free (blue -> cyan)
theme[free_start]="#7EB8D4"
theme[free_mid]="#90C8D8"
theme[free_end]="#A0CCE0"

# Mem/Disk cached (blue shades)
theme[cached_start]="#89B4D4"
theme[cached_mid]="#7EB8D4"
theme[cached_end]="#A0CCE0"

# Mem/Disk available (yellow -> pink)
theme[available_start]="#F0C060"
theme[available_mid]="#F5D080"
theme[available_end]="#E87FA0"

# Mem/Disk used (pink -> red)
theme[used_start]="#E87FA0"
theme[used_mid]="#E94B67"
theme[used_end]="#FF6B81"

# Download (blue -> cyan)
theme[download_start]="#7EB8D4"
theme[download_mid]="#90C8D8"
theme[download_end]="#A0CCE0"

# Upload (yellow -> pink)
theme[upload_start]="#F0C060"
theme[upload_mid]="#F5D080"
theme[upload_end]="#E87FA0"

# Process gradient (pink -> red)
theme[process_start]="#E87FA0"
theme[process_mid]="#E94B67"
theme[process_end]="#F7AABC"
